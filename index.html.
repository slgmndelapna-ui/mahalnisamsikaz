    <link rel="stylesheet" href="style.css">
</head>
<body>

    <main class="workspace">

        <header class="topbar">
            <div class="window-controls">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <p>#mahalnisamsikaz — interactive experience</p>
        </header>

        <section class="editor">
            <div class="editor-header">
                <span>♡ index.js</span>
                <span class="status">● LIVE SESSION</span>
            </div>

            <div class="code-area">
                <div class="line-numbers">
                    01<br>02<br>03<br>04<br>05<br>06<br>07<br>08
                </div>

                <div class="code">
                    <p><span class="purple">const</span> <span class="blue">recipient</span> = <span class="green">"Kaz"</span>;</p>
                    <p><span class="purple">const</span> <span class="blue">sender</span> = <span class="green">"Sam"</span>;</p>
                    <br>
                    <p><span class="gray">// initializing something special...</span></p>
                    <p><span class="purple">function</span> <span class="yellow">beginExperience</span>() {</p>
                    <p class="indent"><span class="purple">return</span> <span class="green">"Are you ready?"</span>;</p>
                    <p>}</p>
                </div>
            </div>

            <div class="terminal">
                <p class="terminal-label">TERMINAL</p>
                <p><span class="green">sam@laptop</span>:~$ initializing experience...</p>
                <p id="terminal-status">Waiting for user interaction<span class="cursor">_</span></p>
            </div>
        </section>

        <section class="interaction">
            <p class="eyebrow">A MESSAGE FROM SAM</p>

            <h1>Would you like to proceed?</h1>

            <p class="subtitle">
                I deserve a kiss after this.
                Nothing complicated. Just something I made.
            </p>

            <div class="choices">
                <button id="yes-button">YES, PROCEED →</button>
                <button id="no-button">NO, NOT YET</button>
            </div>

            <div id="response"></div>

<div id="next-interaction" class="hidden">
    <h2 id="next-question">Before we continue...</h2>
    <p id="next-subtitle">There's something I'd like to ask you.</p>

    <div class="choices">
        <button id="next-yes">YES</button>
        <button id="next-no">NO</button>
    </div>
</div>
